[Unit]
Description=Fingerprint SFM daemon (user)
# Do NOT use After=default.target — that creates an ordering cycle
# when WantedBy=default.target.

[Service]
Type=simple
WorkingDirectory=/home/pi/fingerprint
ExecStart=/home/pi/fingerprint/scripts/run_sfm_daemon.sh
Restart=always
RestartSec=3
StandardOutput=append:/home/pi/fingerprint/logs/sfm_daemon.log
StandardError=append:/home/pi/fingerprint/logs/sfm_daemon.log

[Install]
WantedBy=default.target
